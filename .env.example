PORT=3000
# Run npm run setup to create the admin account.
# Set NODE_ENV=production only when using HTTPS.
NODE_ENV=development
PUBLIC_URL=https://your-domain.example
# Brevo API key (not SMTP key). Keep this server-side.
BREVO_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=Run Msafat <races@your-verified-domain.example>
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Set the currently supported Meta Graph API version for your application.
WHATSAPP_API_VERSION=
# Approved utility template: body parameters in order:
# name, event name, date/time, location, distance
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=ar

# Separate approved templates for Hebrew and English reminders.
# Missing templates keep that language's WhatsApp reminders pending.
WHATSAPP_TEMPLATE_HE=
WHATSAPP_TEMPLATE_LANGUAGE_HE=he
WHATSAPP_TEMPLATE_EN=
WHATSAPP_TEMPLATE_LANGUAGE_EN=en_US

# Enable only behind a trusted reverse proxy that OVERWRITES X-Real-IP.
# Keep 0 for local use or direct public access.
TRUST_PROXY=0

# PayPal merchant credentials. Use sandbox accounts first.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# SMS: confirmation after signup and a reminder 24 hours before the race.
# Never put these credentials in dist/ or client JavaScript.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Choose a Messaging Service SID or a sender hosted in your Twilio account.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=
